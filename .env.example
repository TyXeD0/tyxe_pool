# Used only for bootstrapping from a PRIVATE GitHub repository.
# Never commit a real token.
TYXE_POOL_REPO=YOUR_GITHUB_USERNAME/tyxe_pool
TYXE_POOL_REF=main

# Optional: preselect installer language (ru or en).
# If omitted, the installer asks at startup.
# TYXE_POOL_LANG=ru

# GITHUB_TOKEN is intentionally omitted. Export it only in the shell when needed.
